{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiln:type-thresholds:1",
  "title": "kiln LoRA type: thresholds.yaml",
  "description": "The starting thresholds of a LoRA type (types/<id>/thresholds.yaml), grouped by stage. Every number is a dated prior from earlier work, not a law: the file says `validate on your subject first`, and a project changes a value only with a dated note and a decision. Checked by `kiln types check`.",
  "x-file": "types/<type>/thresholds.yaml",
  "x-owner": "maintainers",
  "x-kind": "record",
  "type": "object",
  "required": [
    "schema",
    "type",
    "dated",
    "status",
    "basis",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kiln/type-thresholds/1"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "dated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "the day these priors were written down"
    },
    "status": {
      "const": "validate on your subject first"
    },
    "basis": {
      "type": "string",
      "minLength": 10
    },
    "change_rule": {
      "type": "string"
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "$ref": "#/$defs/threshold"
        }
      }
    }
  },
  "$defs": {
    "threshold": {
      "type": "object",
      "required": [
        "value",
        "means"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": [
                "number",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          ],
          "description": "a number, a [low, high] range, a switch, or null when this type has no measured value"
        },
        "unit": {
          "type": "string"
        },
        "means": {
          "type": "string",
          "minLength": 5
        },
        "basis": {
          "type": "string"
        }
      }
    }
  }
}

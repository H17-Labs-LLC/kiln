{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiln:type-checklist:1",
  "title": "kiln LoRA type: checklist.yaml",
  "description": "The checklist skeleton of a LoRA type (types/<id>/checklist.yaml): the few hard rules every training image is judged by. An identity checklist (character types) has 6-10 items and always a `body` item in adult geometry; a style checklist has 3-8 items about the rendering and none about who is drawn. Checked by `kiln types check`.",
  "x-file": "types/<type>/checklist.yaml",
  "x-owner": "maintainers",
  "x-kind": "record",
  "type": "object",
  "required": [
    "schema",
    "type",
    "kind",
    "guidance",
    "vocabulary",
    "items",
    "review_only"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kiln/type-checklist/1"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "identity",
        "style"
      ]
    },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "vocabulary": {
      "type": "object",
      "required": [
        "viewpoints",
        "framings"
      ],
      "additionalProperties": false,
      "properties": {
        "viewpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewpoint"
          },
          "uniqueItems": true
        },
        "framings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/framing"
          },
          "uniqueItems": true
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "review_only": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_only"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "identity"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 6,
            "maxItems": 10,
            "contains": {
              "type": "object",
              "properties": {
                "key": {
                  "const": "body"
                }
              },
              "required": [
                "key"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "style"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 3,
            "maxItems": 8
          }
        }
      }
    }
  ],
  "$defs": {
    "viewpoint": {
      "enum": [
        "front",
        "front_three_quarter",
        "profile",
        "back",
        "rear_three_quarter",
        "unusual"
      ]
    },
    "framing": {
      "enum": [
        "close",
        "medium",
        "full",
        "wide"
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "skip_when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewpoint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewpoint"
          },
          "uniqueItems": true
        },
        "framing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/framing"
          },
          "uniqueItems": true
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "key",
        "heading",
        "text",
        "review",
        "example"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "heading": {
          "type": "string",
          "minLength": 3
        },
        "text": {
          "type": "string",
          "minLength": 10
        },
        "skip_when": {
          "$ref": "#/$defs/skip_when"
        },
        "review": {
          "type": "object",
          "required": [
            "label",
            "hint"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "hint": {
              "type": "string"
            }
          }
        },
        "example": {
          "type": "string",
          "description": "the item filled in for the synthetic demo subject"
        }
      }
    },
    "review_only": {
      "type": "object",
      "required": [
        "key",
        "label",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "skip_when": {
          "$ref": "#/$defs/skip_when"
        },
        "when": {
          "type": "string",
          "description": "the intake answer that switches the check on, for example `mouth = never_teeth`"
        }
      }
    }
  }
}

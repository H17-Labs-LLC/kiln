{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiln:type-caption-rules:1",
  "title": "kiln LoRA type: caption_rules.yaml",
  "description": "The caption rules of a LoRA type (types/<id>/caption_rules.yaml): caption levels and lengths, the order of a trained caption, what never goes into a caption, view tags and the dataset settings the captions assume. Read by the caption tools; checked by `kiln types check`.",
  "x-file": "types/<type>/caption_rules.yaml",
  "x-owner": "maintainers",
  "x-kind": "record",
  "type": "object",
  "required": [
    "schema",
    "type",
    "levels",
    "train_level",
    "structure",
    "template",
    "trigger",
    "class_word",
    "style_tag",
    "not_in_captions",
    "view_tags",
    "forbidden",
    "vocabulary",
    "rules",
    "dataset_settings",
    "example"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kiln/type-caption-rules/1"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "levels": {
      "type": "object",
      "required": [
        "short",
        "medium",
        "long"
      ],
      "additionalProperties": false,
      "properties": {
        "short": {
          "$ref": "#/$defs/level"
        },
        "medium": {
          "$ref": "#/$defs/level"
        },
        "long": {
          "$ref": "#/$defs/level"
        }
      }
    },
    "train_level": {
      "enum": [
        "short",
        "medium",
        "long"
      ]
    },
    "structure": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "template": {
      "type": "string",
      "pattern": "^\\{trigger\\}"
    },
    "trigger": {
      "type": "object",
      "required": [
        "position",
        "keep_tokens",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "const": "first"
        },
        "keep_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "class_word": {
      "type": "object",
      "required": [
        "applies",
        "default",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "style_tag": {
      "type": "object",
      "required": [
        "applies",
        "default",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "default_outfit": {
      "type": "object",
      "required": [
        "tag",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ],
          "description": "an outfit token plus a booru material tag; filled from intake question 7"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "mouth": {
      "type": "object",
      "required": [
        "from_intake",
        "never_teeth"
      ],
      "additionalProperties": false,
      "properties": {
        "from_intake": {
          "type": "string"
        },
        "never_teeth": {
          "type": "object",
          "required": [
            "write",
            "never",
            "negative"
          ],
          "additionalProperties": false,
          "properties": {
            "write": {
              "type": "string"
            },
            "never": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "negative": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "not_in_captions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the fixed traits the trigger learns; empty in the shipped type, filled from intake question 3"
    },
    "view_tags": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "front": {
          "type": [
            "string",
            "null"
          ]
        },
        "front_three_quarter": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "back": {
          "type": [
            "string",
            "null"
          ]
        },
        "rear_three_quarter": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "forbidden": {
      "type": "object",
      "required": [
        "quality_words",
        "source_words",
        "age_words"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "properties": {
        "quality_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "age_words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "wrong word -> the word to use; one term per concept"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "dataset_settings": {
      "type": "object",
      "required": [
        "shuffle_caption",
        "caption_dropout_rate",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "shuffle_caption": {
          "type": "boolean"
        },
        "caption_dropout_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "why": {
          "type": "string"
        }
      }
    },
    "example": {
      "type": "object",
      "required": [
        "subject",
        "caption",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "later": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "experiments that belong in their own run, not mixed into one dataset"
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "required": [
        "words",
        "trained",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "words": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "trained": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string"
        }
      }
    }
  }
}

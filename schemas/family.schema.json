{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiln:family:1",
  "title": "model family (kiln)",
  "description": "One model family per file, families/<id>.yaml. The shared keys (all but `schema` and the tool block) are identical in the easel and kiln copies; `sync_common.py --check` compares them. A family with `inherits` reads the blocks it leaves out from its parent, except `licence_summary` and `host_ram_gb`, which every file carries.",
  "x-file": "families/<id>.yaml",
  "x-owner": "maintainers (generated from one private source)",
  "x-kind": "record",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "status",
    "inherits",
    "licence_summary",
    "host_ram_gb"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kiln/family/1",
      "description": "the format and its version; always the first key"
    },
    "id": {
      "$ref": "#/$defs/family_id",
      "description": "equals the file stem"
    },
    "name": {
      "type": "string",
      "description": "display name"
    },
    "status": {
      "enum": [
        "tested",
        "experimental",
        "unverified",
        "listed"
      ],
      "description": "tested = trained or rendered with on the reference machine; experimental = run once, not in the tested path; unverified = priors only; listed = known, no recipe"
    },
    "inherits": {
      "anyOf": [
        {
          "$ref": "#/$defs/family_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "the parent family; a block this file leaves out is read from the parent (deep merge, the child's keys win)"
    },
    "architecture": {
      "type": "object",
      "required": [
        "kind",
        "latent_channels",
        "text_encoders",
        "native_resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "for example unet-sdxl, dit-flux; unknown when not known"
        },
        "latent_channels": {
          "type": [
            "integer",
            "null"
          ]
        },
        "text_encoders": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "native_resolution": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the side length in pixels the family was trained at"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "licence_summary": {
      "type": "object",
      "description": "the base model's licence in one line; every family carries its own, inherited or not (families check fails otherwise). It is the fallback for foundation bases only: a resource's own licence block wins",
      "required": [
        "status",
        "name",
        "text",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "unknown"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "the licence's name, null when not recorded"
        },
        "text": {
          "type": "string",
          "description": "one line a person can act on, for example 'unverified: read the model card'"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ],
          "description": "the model card; null is allowed (families check warns)"
        },
        "spdx": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "host_ram_gb": {
      "type": "object",
      "description": "what the scheduler waits for before it starts a job of this family",
      "required": [
        "train",
        "eval",
        "eval_includes_comfyui_server",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "train": {
          "type": [
            "number",
            "null"
          ],
          "description": "free host RAM a training step needs",
          "minimum": 0
        },
        "eval": {
          "type": [
            "number",
            "null"
          ],
          "description": "free host RAM an eval render needs",
          "minimum": 0
        },
        "eval_includes_comfyui_server": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true = the eval number already covers the ComfyUI server"
        },
        "basis": {
          "type": "string",
          "description": "measured on the reference machine, inherited, or a prior; say which"
        }
      }
    },
    "training": {
      "type": "object",
      "description": "kiln's training recipe for this family",
      "required": [
        "supported"
      ],
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "boolean",
          "description": "false = kiln has no tested training path for this family yet"
        },
        "basis": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "trainer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "module": {
              "type": "string"
            },
            "dim": {
              "type": "integer",
              "minimum": 1
            },
            "alpha": {
              "type": "number",
              "minimum": 0
            },
            "train_unet_only": {
              "type": "boolean"
            }
          }
        },
        "optimizer": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "learning_rate": {
              "type": "number"
            },
            "unet_lr": {
              "type": "number"
            },
            "text_encoder_lr": {
              "type": "number"
            },
            "lr_scheduler": {
              "type": "string"
            },
            "lr_warmup_steps": {
              "type": "integer",
              "minimum": 0
            },
            "max_grad_norm": {
              "type": "number"
            }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "base": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "buckets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "min": {
                  "type": "integer"
                },
                "max": {
                  "type": "integer"
                },
                "step": {
                  "type": "integer"
                }
              }
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "gradient_accumulation_steps": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "steps": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "default": {
              "type": "integer",
              "minimum": 1
            },
            "save_every": {
              "type": "integer",
              "minimum": 1
            },
            "guidance": {
              "type": "string"
            }
          }
        },
        "sd_scripts_args": {
          "type": "object",
          "description": "sd-scripts flag name (no dashes) -> value",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "flags_8gb": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "flag": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "flag"
                ]
              },
              {
                "required": [
                  "item"
                ]
              }
            ]
          },
          "description": "the audited flag recipe for 8 GB, one rationale per flag"
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "flag",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "flag": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "measured_8gb": {
          "type": "object",
          "description": "the measured table: date, hardware and numbers",
          "properties": {
            "date": {
              "$ref": "#/$defs/date"
            },
            "hardware": {
              "type": "string"
            }
          },
          "required": [
            "date",
            "hardware"
          ]
        },
        "eval_render": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_prefix": {
              "type": "string"
            },
            "negative_extra": {
              "type": "string"
            },
            "clip_skip": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "backend": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "inherits": {
        "type": "null"
      }
    }
  },
  "then": {
    "required": [
      "architecture",
      "description",
      "training"
    ]
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "a date, YYYY-MM-DD"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "a model family id: the stem of families/<id>.yaml"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "an http(s) URL"
    }
  }
}
